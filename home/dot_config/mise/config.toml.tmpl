# Pinned so every machine runs the same versions.
# Upgrade: `mise outdated --bump`, then bump here with `chezmoi edit ~/.config/mise/config.toml`.
[tools]
node = "24.16.0"
go = "1.26.4"
fzf = "0.74.5"
ripgrep = "15.2.0"
age = "1.3.2"
fd = "10.5.0"
bat = "0.26.1"
zoxide = "0.10.0"
# Binary for the tmux-fingers plugin (prefix + F)
"github:Morantron/tmux-fingers" = "2.7.1"
# tmux session picker (prefix + T)
"aqua:joshmedeski/sesh" = "2.34.0"
{{- if not .arch }}
# Ubuntu's packages are too old for LazyVim
neovim = "0.12.6"
lazygit = "0.66.2"
{{- end }}
{{- if .yubikey }}
age-plugin-yubikey = "0.5.1"
{{- end }}
