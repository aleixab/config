-- The util.chezmoi extra assumes ~/.local/share/chezmoi; point it at this
-- machine's actual source dir (filled in by chezmoi when applied).
local source_dir = "{{ .chezmoi.sourceDir }}"

return {
  {
    "alker0/chezmoi.vim",
    init = function()
      vim.g["chezmoi#use_tmp_buffer"] = 1
      vim.g["chezmoi#source_dir_path"] = source_dir
    end,
  },
  {
    "xvzc/chezmoi.nvim",
    init = function()
      -- apply to ~ on save when editing a file in the source dir
      vim.api.nvim_create_autocmd({ "BufRead", "BufNewFile" }, {
        pattern = { source_dir .. "/*" },
        callback = function()
          vim.schedule(require("chezmoi.commands.__edit").watch)
        end,
      })
    end,
  },
}
