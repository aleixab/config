#!/bin/bash
# Installs system packages, oh-my-zsh and its plugins, and TPM.
# Re-runs whenever this file changes.

set -euo pipefail

echo "==> Installing system packages..."
{{ if .arch -}}
sudo pacman -S --noconfirm --needed git curl zsh mise tmux neovim lazygit rust jq bc fastfetch
{{- if .gui }}
# i3 desktop
sudo pacman -S --noconfirm --needed i3-wm polybar rofi picom dunst feh thunar alacritty ttf-meslo-nerd
if command -v paru &>/dev/null; then
  paru -S --noconfirm --needed rofi-games
fi
{{- end }}
{{- if .yubikey }}
sudo pacman -S --noconfirm --needed yubikey-manager pcsclite ccid libfido2
sudo systemctl enable --now pcscd.socket
{{- end }}
{{- else if eq .chezmoi.osRelease.id "ubuntu" "debian" -}}
sudo apt-get update
sudo apt-get install -y git curl zsh tmux jq bc unzip xz-utils build-essential
{{- if .yubikey }}
sudo apt-get install -y yubikey-manager pcscd libfido2-1
sudo systemctl enable --now pcscd.socket
{{- end }}
{{- if .gui }}

# Terminal font (alacritty), not packaged on Ubuntu 22.04
if ! fc-list | grep -q "MesloLGS Nerd Font Mono"; then
  mkdir -p "$HOME/.local/share/fonts/meslo"
  curl -fsSL https://github.com/ryanoasis/nerd-fonts/releases/download/v3.5.1/Meslo.tar.xz | tar -xJ -C "$HOME/.local/share/fonts/meslo"
  fc-cache -f
fi
{{- end }}

if ! command -v mise &>/dev/null && [ ! -x "$HOME/.local/bin/mise" ]; then
  curl -fsSL https://mise.run | sh
fi
{{- else -}}
echo "    unknown distro {{ .chezmoi.osRelease.id }}, skipping system packages"
{{- end }}

echo "==> Installing oh-my-zsh..."
if [ ! -d "$HOME/.oh-my-zsh" ]; then
  git clone --depth 1 https://github.com/ohmyzsh/ohmyzsh "$HOME/.oh-my-zsh"
fi

echo "==> Installing zsh plugins..."
ZSH_CUSTOM="${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}"
[ -d "$ZSH_CUSTOM/plugins/zsh-vi-mode" ] || git clone https://github.com/jeffreytse/zsh-vi-mode "$ZSH_CUSTOM/plugins/zsh-vi-mode"
[ -d "$ZSH_CUSTOM/plugins/fzf-tab" ] || git clone https://github.com/Aloxaf/fzf-tab "$ZSH_CUSTOM/plugins/fzf-tab"

echo "==> Installing TPM (tmux plugin manager)..."
[ -d "$HOME/.tmux/plugins/tpm/.git" ] || { rm -rf "$HOME/.tmux/plugins/tpm"; git clone https://github.com/tmux-plugins/tpm "$HOME/.tmux/plugins/tpm"; }

if [ "$(basename "${SHELL:-}")" != "zsh" ]; then
  echo "==> Setting zsh as default shell..."
  chsh -s "$(command -v zsh)"
fi
